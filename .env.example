# Copy this file to ".env" and fill it in. Never commit ".env".
SECRET_KEY=change-me-to-a-long-random-string
SITE_URL=http://127.0.0.1:5000

# PostgreSQL connection string (Neon / Supabase). Leave empty to use local SQLite.
DATABASE_URL=

# ---- Email (password reset + reminders). Free: Brevo, 300 emails/day ----
MAIL_FROM=your-verified-sender@example.com
MAIL_FROM_NAME=Do.iT
BREVO_API_KEY=
# (alternative for your own computer only: SMTP_HOST, SMTP_PORT, SMTP_USER, SMTP_PASSWORD)

# Secret word that lets your free cron service trigger reminder emails
CRON_SECRET=change-me-another-long-random-string
DEFAULT_TZ=Africa/Lagos
DIGEST_HOUR=7

# ---- AI assistant (use ONE) ----
# Free option: Google Gemini (https://aistudio.google.com)
GEMINI_API_KEY=
# Paid option: Anthropic Claude (https://console.anthropic.com)
ANTHROPIC_API_KEY=
# AI_PROVIDER=gemini
# AI_MODEL=gemini-2.5-flash
